<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Color to use when the navigation item is selected (checked) -->
    <item android:state_checked="true" android:color="@color/primary_dark" />

    <!-- Default color for unselected navigation items -->
    <item android:state_checked="false" android:color="@color/dark_gray" />

</selector>
