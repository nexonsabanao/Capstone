<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Nutriority" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>

        <!-- Material 3 Color Fixes: Eliminate pinkish/tonal tints -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorControlActivated">@color/primary_dark</item>
        <!-- Force surfaces to be pure white -->
        <item name="colorSurface">@android:color/white</item>
        <item name="colorSurfaceVariant">@android:color/white</item>

        <item name="elevationOverlayEnabled">false</item>

        <item name="elevationOverlayColor">@android:color/transparent</item>

        <item name="colorSurfaceContainer">@android:color/white</item>
        <item name="colorSurfaceContainerLowest">@android:color/white</item>
        <item name="colorSurfaceContainerLow">@android:color/white</item>
        <item name="colorSurfaceContainerHigh">@android:color/white</item>
        <item name="colorSurfaceContainerHighest">@android:color/white</item>
        
        <!-- Fix for PopupMenu Theme -->
        <item name="popupMenuStyle">@style/Theme.Nutriority.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Theme.Nutriority.PopupMenu</item>
    </style>

    <!-- Custom Popup style using the white drawable to bypass tonal tints -->
    <style name="Theme.Nutriority.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:itemBackground">@android:color/white</item>
        <item name="android:popupBackground">@drawable/bg_white_rounded_16</item>
    </style>

    <!--  2. SPLASH THEME  -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@color/transparent</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.Nutriority</item>
    </style>

    <style name="Theme.Nutriority" parent="Base.Theme.Nutriority"/>

    <style name="ShapeAppearance.App.CornerSize16dp" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.App.CornerSize24dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.App.CornerSize50percent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="DayLabel" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/darker_gray</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CalendarDate" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize" tools:ignore="SpUsage">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalendarDate.Faded">
        <item name="android:textColor">@android:color/darker_gray</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="CalendarDate.Selected">
        <item name="android:textColor">@color/primary_dark</item>
    </style>

    <style name="CollapsedAppBar" parent="@android:style/TextAppearance.Medium">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ExpandedAppBar" parent="@android:style/TextAppearance.Large">
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FilterChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <style name="BottomNav.Text" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BottomNav.NoIndicator" parent="">
        <item name="colorSecondaryContainer">@android:color/transparent</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">56dp</item>
        <item name="android:background">#E1E2E5</item>
    </style>

</resources>
