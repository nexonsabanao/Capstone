<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Nutriority" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <!--  2. SPLASH THEME (This part is correct)  -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!--  Set the initial background to black  -->
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <!--  Set the icon to transparent so it doesn't appear  -->
        <item name="windowSplashScreenAnimatedIcon">@color/transparent</item>
        <!--  After the splash, switch to your main theme  -->
        <item name="postSplashScreenTheme">@style/Base.Theme.Nutriority</item>
    </style>
    <!--  This style just inherits the corrected base theme. It's good practice.  -->
    <style name="Theme.Nutriority" parent="Base.Theme.Nutriority"/>
    <!--  In your themes.xml or styles.xml  -->
    <style name="AppTheme.NumberPicker" parent="Theme.AppCompat.Light">
        <item name="android:textColorPrimary">@color/dark_gray</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ShapeAppearance.App.CornerSize16dp" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="NoActiveIndicator" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorHeight">0dp</item>
    </style>


    <!--    fragment profile-->
    <style name="ProfileSectionHeader" parent="Widget.AppCompat.TextView">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceSubtitle1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Style for the left-side labels like "Gender", "Height", etc. -->
    <style name="ProfileTableLabel" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">150dp</item> <!-- Fixed width for alignment -->
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBody1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Style for the right-side values that display the user's data -->
    <style name="ProfileTableValue" parent="Widget.AppCompat.TextView">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBody1</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>