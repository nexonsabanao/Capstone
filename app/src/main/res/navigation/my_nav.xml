<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.nutriority.ui.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_viewPagerFragment"
            app:destination="@id/viewPagerFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_mainTabsFragment"
            app:destination="@id/mainTabsFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/viewPagerFragment"
        android:name="com.example.nutriority.ui.onboarding.ViewPagerFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_view_pager">
        <action
            android:id="@+id/action_viewPagerFragment_to_mainTabsFragment"
            app:destination="@id/mainTabsFragment"
            app:popUpTo="@id/viewPagerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Main Tabs Container (Hosts Home, Workout, Meal, Profile) -->
    <fragment
        android:id="@+id/mainTabsFragment"
        android:name="com.example.nutriority.ui.MainTabsFragment"
        android:label="Main"
        tools:layout="@layout/fragment_main_tabs">
        <action
            android:id="@+id/action_mainTabs_to_articleDetailFragment"
            app:destination="@id/articleDetailFragment" />
        <action
            android:id="@+id/action_mainTabs_to_personalizedWorkoutFragment"
            app:destination="@id/personalizedWorkoutFragment" />
        <action
            android:id="@+id/action_mainTabs_to_mealDetailFragment"
            app:destination="@id/mealDetailFragment" />
        <action
            android:id="@+id/action_mainTabs_to_workoutDetailFragment"
            app:destination="@id/workoutDetailFragment" />
        <action
            android:id="@+id/action_mainTabs_to_exerciseLibraryFragment"
            app:destination="@id/exerciseLibraryFragment" />
        <action
            android:id="@+id/action_mainTabs_to_allWorkoutsFragment"
            app:destination="@id/allWorkoutsFragment" />
    </fragment>

    <!-- Detail Screens (Accessed via mainTabsFragment) -->
    <fragment
        android:id="@+id/mealDetailFragment"
        android:name="com.example.nutriority.ui.meal.MealDetailFragment"
        android:label="Meal Detail"
        tools:layout="@layout/fragment_meal_detail">
        <argument
            android:name="meal_json"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/workoutDetailFragment"
        android:name="com.example.nutriority.ui.workout.WorkoutDetailFragment"
        android:label="Workout Detail"
        tools:layout="@layout/fragment_workout_detail">
        <argument
            android:name="workout_id"
            app:argType="integer" />
        <action
            android:id="@+id/action_workoutDetailFragment_to_exerciseDetailFragment"
            app:destination="@id/exerciseDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/exerciseDetailFragment"
        android:name="com.example.nutriority.ui.workout.ExerciseDetailFragment"
        android:label="Exercise Detail"
        tools:layout="@layout/fragment_exercise_detail">
        <argument
            android:name="exercise_id"
            app:argType="integer" />
        <argument
            android:name="exercise_position"
            app:argType="integer" />
        <argument
            android:name="total_exercises"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/personalizedWorkoutFragment"
        android:name="com.example.nutriority.ui.workout.PersonalizedWorkoutFragment"
        android:label="Personalized Workout"
        tools:layout="@layout/fragment_personalized_workout">
        <action
            android:id="@+id/action_personalizedWorkoutFragment_to_workoutDetailFragment"
            app:destination="@id/workoutDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/exerciseLibraryFragment"
        android:name="com.example.nutriority.ui.workout.ExerciseLibraryFragment"
        android:label="Exercise Library"
        tools:layout="@layout/fragment_exercise_library" />

    <fragment
        android:id="@+id/allWorkoutsFragment"
        android:name="com.example.nutriority.ui.workout.AllWorkoutsFragment"
        android:label="All Workouts"
        tools:layout="@layout/fragment_all_workouts">
        <action
            android:id="@+id/action_allWorkoutsFragment_to_workoutDetailFragment"
            app:destination="@id/workoutDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/articleDetailFragment"
        android:name="com.example.nutriority.ui.home.ArticleDetailFragment"
        android:label="Article Detail"
        tools:layout="@layout/fragment_article_detail">
        <argument
            android:name="article_json"
            app:argType="string" />
    </fragment>

</navigation>
