<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.nutriority.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_personalizedWorkoutFragment"
            app:destination="@id/personalizedWorkoutFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_meal"
        android:name="com.example.nutriority.ui.meal.MealFragment"
        android:label="Meal"
        tools:layout="@layout/fragment_meal" />

    <fragment
        android:id="@+id/navigation_workout"
        android:name="com.example.nutriority.ui.workout.WorkoutFragment"
        android:label="Workout"
        tools:layout="@layout/fragment_workout" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.nutriority.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />
    <fragment
        android:id="@+id/personalizedWorkoutFragment"
        android:name="com.example.nutriority.ui.workout.PersonalizedWorkoutFragment"
        android:label="fragment_personalized_workout"
        tools:layout="@layout/fragment_personalized_workout" />

</navigation>