<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="20dp"
    android:paddingBottom="24dp"
    android:background="@android:color/transparent"
    tools:context=".onboarding.screens.SecondScreen">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="24dp"
        android:alpha="0.7"
        android:clickable="true"
        android:contentDescription="action_back"
        android:focusable="true"
        android:padding="4dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toTopOf="@+id/titleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/dark_gray"
        tools:ignore="TouchTargetSizeCheck" />

    <TextView
        android:id="@+id/skipButton"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="24dp"
        android:alpha="0.7"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="48dp"
        android:paddingHorizontal="8dp"
        android:text="skip"
        android:textColor="@color/dark_gray"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/backButton"
        tools:ignore="TouchTargetSizeCheck" />

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="80dp"
        android:fontFamily="@font/barlow_bold"
        android:gravity="center_horizontal"
        android:text="Tell Us About Yourself"
        android:textColor="@color/dark_gray"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal"
        android:text="This helps us personalize your workout plan"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/titleTextView"
        app:layout_constraintStart_toStartOf="@id/titleTextView"
        app:layout_constraintTop_toBottomOf="@id/titleTextView" />

    <LinearLayout
        android:id="@+id/card_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/nextButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitleTextView"
        app:layout_constraintVertical_bias="0.4">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/heightCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/heightLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:fontFamily="@font/barlow_semibold"
                    android:text="Height"
                    android:textColor="@color/dark_gray"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="@id/heightUnitToggleGroup"
                    app:layout_constraintEnd_toStartOf="@id/heightUnitToggleGroup"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/heightUnitToggleGroup" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/heightUnitToggleGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/heightLabel"
                    app:layout_constraintTop_toTopOf="parent"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/btnCm"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="cm"
                        app:backgroundTint="@color/toggle_button_background_color"
                        tools:ignore="TouchTargetSizeCheck" />

                    <Button
                        android:id="@+id/btnFt"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="ft"
                        app:backgroundTint="@color/toggle_button_background_color"
                        tools:ignore="TouchTargetSizeCheck" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/heightPickerRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heightUnitToggleGroup"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_picker_number" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/picker_fade_overlay"
                    app:layout_constraintTop_toTopOf="@id/heightPickerRecyclerView"
                    app:layout_constraintBottom_toBottomOf="@id/heightPickerRecyclerView"
                    app:layout_constraintStart_toStartOf="@id/heightPickerRecyclerView"
                    app:layout_constraintEnd_toEndOf="@id/heightPickerRecyclerView"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:contentDescription="picker_indicator"
                    android:src="@drawable/outline_arrow_drop_down"
                    app:layout_constraintBottom_toBottomOf="@id/heightPickerRecyclerView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="@color/green" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/weightCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/weightLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:fontFamily="@font/barlow_semibold"
                    android:text="Weight"
                    android:textColor="@color/dark_gray"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="@id/weightUnitToggleGroup"
                    app:layout_constraintEnd_toStartOf="@id/weightUnitToggleGroup"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/weightUnitToggleGroup" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/weightUnitToggleGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/weightLabel"
                    app:layout_constraintTop_toTopOf="parent"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/btnKg"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="kg"
                        app:backgroundTint="@color/toggle_button_background_color"
                        tools:ignore="TouchTargetSizeCheck" />

                    <Button
                        android:id="@+id/btnLbs"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="lbs"
                        app:backgroundTint="@color/toggle_button_background_color"
                        tools:ignore="TouchTargetSizeCheck" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/weightPickerRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/weightUnitToggleGroup"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_picker_number" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/picker_fade_overlay"
                    app:layout_constraintTop_toTopOf="@id/weightPickerRecyclerView"
                    app:layout_constraintBottom_toBottomOf="@id/weightPickerRecyclerView"
                    app:layout_constraintStart_toStartOf="@id/weightPickerRecyclerView"
                    app:layout_constraintEnd_toEndOf="@id/weightPickerRecyclerView"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:contentDescription="picker_indicator"
                    android:src="@drawable/outline_arrow_drop_down"
                    app:layout_constraintBottom_toBottomOf="@id/weightPickerRecyclerView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="@color/green" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <Button
        android:id="@+id/nextButton"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:alpha="0.5"
        android:backgroundTint="@color/green"
        android:enabled="false"
        android:paddingVertical="16dp"
        android:text="@string/action_next"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
