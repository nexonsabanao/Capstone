<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".ui.home.HomeFragment">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/homeGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Welcome to,"
            android:textColor="#757575"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nutriority"
            android:textColor="#212121"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_nested_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- CLEAN GREEN REDESIGN FOR ONGOING WORKOUT BANNER -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ongoingWorkoutCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/green"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <com.mikhaellopez.circularprogressbar.CircularProgressBar
                        android:id="@+id/ongoingProgress"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        app:cpb_background_progressbar_color="#4DFFFFFF"
                        app:cpb_background_progressbar_width="4dp"
                        app:cpb_progressbar_color="@android:color/white"
                        app:cpb_progressbar_width="6dp"
                        app:cpb_progress="0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvOngoingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="sans-serif"
                        android:text="SESSION ACTIVE"
                        android:textColor="#CCFFFFFF"
                        android:textSize="11sp"
                        android:letterSpacing="0.15"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/ongoingProgress"
                        app:layout_constraintTop_toTopOf="@id/ongoingProgress" />

                    <TextView
                        android:id="@+id/tvOngoingTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="Continue Training"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/btnResumeOngoing"
                        app:layout_constraintStart_toStartOf="@id/tvOngoingStatus"
                        app:layout_constraintTop_toBottomOf="@id/tvOngoingStatus" />

                    <TextView
                        android:id="@+id/tvOngoingSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="3 from 8 exercises done"
                        android:textColor="#E0F2F1"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@id/btnResumeOngoing"
                        app:layout_constraintStart_toStartOf="@id/tvOngoingTitle"
                        app:layout_constraintTop_toBottomOf="@id/tvOngoingTitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResumeOngoing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@android:color/white"
                        android:text="RESUME"
                        android:textColor="@color/green"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        app:cornerRadius="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hero Card Section -->
            <include
                android:id="@+id/sevenDaysWorkoutCard"
                layout="@layout/item_large_button_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp" />

            <!-- Body Focus / Workouts Section -->
            <TextView
                android:id="@+id/workoutsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="24dp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:text="Body Focus"
                android:textColor="#212121"
                android:textSize="20sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/workoutsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="20dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:listitem="@layout/item_preview_workout" />

                <ProgressBar
                    android:id="@+id/workoutsProgressBar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_margin="32dp"
                    android:indeterminateTint="@color/green" />
            </FrameLayout>

            <me.relex.circleindicator.CircleIndicator2
                android:id="@+id/workoutsIndicator"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:layout_height="24dp"
                android:visibility="gone"
                tools:visibility="visible"
                app:ci_drawable="@drawable/ic_indicator_dot" />

            <!-- Meal Plan Section -->
            <include
                android:id="@+id/mealPlanCard"
                layout="@layout/item_meal_plan_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="20dp" />

            <TextView
                android:id="@+id/mealsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="24dp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:text="Healthy Recipes"
                android:textColor="#212121"
                android:textSize="20sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mealsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="20dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:listitem="@layout/item_preview_meal_card" />

                <ProgressBar
                    android:id="@+id/mealsProgressBar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_margin="32dp"
                    android:indeterminateTint="@color/green" />
            </FrameLayout>

            <!-- Articles Section -->
            <TextView
                android:id="@+id/articlesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="24dp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:text="Wellness Articles"
                android:textColor="#212121"
                android:textSize="20sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/articlesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:listitem="@layout/item_article_preview" />

                <ProgressBar
                    android:id="@+id/articlesProgressBar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_margin="32dp"
                    android:indeterminateTint="@color/green" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
