<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/btn_add_set"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_set_number"
        android:backgroundTint="#9E9E9E"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:text="Add"
        android:textAllCaps="true"
        android:textColor="#BDBDBD"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/btn_add_set"
        app:layout_constraintStart_toStartOf="@id/btn_add_set"
        app:layout_constraintTop_toBottomOf="@id/btn_add_set" />

</androidx.constraintlayout.widget.ConstraintLayout>