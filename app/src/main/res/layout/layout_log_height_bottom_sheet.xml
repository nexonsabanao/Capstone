<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:padding="20dp">

    <View
        android:id="@+id/view_drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E0E0E0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="Height"
        android:textColor="#212121"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_drag_handle" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/heightUnitToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/btn_cm"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="cm"
            android:textColor="@color/toggle_button_text_color"
            android:textSize="12sp"
            app:backgroundTint="@color/toggle_button_background_color" />

        <Button
            android:id="@+id/btn_ft"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="ft"
            android:textColor="@color/toggle_button_text_color"
            android:textSize="12sp"
            app:backgroundTint="@color/toggle_button_background_color" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <LinearLayout
        android:id="@+id/display_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heightUnitToggle">

        <TextView
            android:id="@+id/tv_height_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="#212121"
            android:textSize="40sp"
            tools:text="170" />

        <TextView
            android:id="@+id/tv_unit_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="#212121"
            android:textSize="16sp"
            android:text="cm" />
    </LinearLayout>

    <com.example.nutriority.ui.custom.RulerView
        android:id="@+id/heightRuler"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/display_layout"
        app:ruler_defaultValue="170"
        app:ruler_indicatorColor="@color/green"
        app:ruler_indicatorWidth="4dp"
        app:ruler_maxValue="250"
        app:ruler_minValue="100"
        app:ruler_tickInterval="14dp"
        app:ruler_textColor="#212121"
        app:ruler_tickColor="#E0E0E0"
        app:ruler_majorTickFactor="10"
        app:ruler_decimal_places="0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/green"
        android:fontFamily="sans-serif-bold"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heightRuler" />

</androidx.constraintlayout.widget.ConstraintLayout>
