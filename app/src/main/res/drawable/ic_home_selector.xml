<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State when the item is checked (selected/active) - Show the FILLED icon -->
    <item android:drawable="@drawable/ic_home_fl" android:state_checked="true" />

    <!-- Default state when the item is not checked - Show the OUTLINE icon -->
    <item android:drawable="@drawable/ic_home_ol" android:state_checked="false" />
</selector>
