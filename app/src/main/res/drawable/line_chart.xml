<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_weight_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weight"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/button_log"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/design_default_color_primary"
            android:text="Log"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_current_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Current"
            android:textColor="@android:color/darker_gray"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_weight_title" />

        <TextView
            android:id="@+id/text_current_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="61 kg"
            android:textColor="@android:color/black"
            android:textSize="40sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_current_label" />

        <TextView
            android:id="@+id/text_heaviest_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heaviest"
            android:textColor="@android:color/darker_gray"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/text_current_label"
            app:layout_constraintEnd_toStartOf="@+id/text_heaviest_value"
            app:layout_constraintHorizontal_chainStyle="packed" />

        <TextView
            android:id="@+id/text_heaviest_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="61"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            app:layout_constraintBaseline_toBaselineOf="@id/text_heaviest_label"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_lightest_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lightest"
            android:textColor="@android:color/darker_gray"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/text_lightest_value"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintTop_toBottomOf="@id/text_heaviest_label" />

        <TextView
            android:id="@+id/text_lightest_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="54"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/text_lightest_label" />

        <LinearLayout
            android:id="@+id/y_axis_labels"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:gravity="bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_current_weight">

            <TextView style="@style/YAxisLabel" android:text="64" android:layout_marginBottom="10dp"/>
            <TextView style="@style/YAxisLabel" android:text="62" android:layout_marginBottom="10dp"/>
            <TextView style="@style/YAxisLabel" android:text="60" android:layout_marginBottom="10dp"/>
            <TextView style="@style/YAxisLabel" android:text="58" android:layout_marginBottom="10dp"/>
            <TextView style="@style/YAxisLabel" android:text="56" android:layout_marginBottom="10dp"/>
            <TextView style="@style/YAxisLabel" android:text="54" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_month_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="November"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintBottom_toTopOf="@id/graph_placeholder"
            app:layout_constraintStart_toStartOf="@id/graph_placeholder"
            app:layout_constraintEnd_toEndOf="@id/graph_placeholder"
            app:layout_constraintVertical_bias="1"
            android:layout_marginBottom="4dp"/>


        <View
            android:id="@+id/graph_placeholder"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:background="#15000000"
            app:layout_constraintBottom_toTopOf="@id/x_axis_labels"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/y_axis_labels"
            app:layout_constraintTop_toBottomOf="@id/text_current_weight"
            tools:ignore="ContentDescription"
            android:contentDescription="Weight tracking graph area" />

        <LinearLayout
            android:id="@+id/x_axis_labels"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/graph_placeholder"
            app:layout_constraintTop_toBottomOf="@id/graph_placeholder">

            <TextView style="@style/XAxisLabel" android:text="28" />
            <TextView style="@style/XAxisLabel" android:text="01" />
            <TextView style="@style/XAxisLabel" android:text="05" />
            <TextView style="@style/XAxisLabel" android:text="09" />
            <TextView style="@style/XAxisLabel" android:text="13" />
            <TextView style="@style/XAxisLabel" android:text="17" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>