{
  "exercises": [
    {
      "id": "jumping_jacks",
      "name": "Jumping Jacks",
      "description": "Stand with feet together and arms at sides. Jump while spreading legs and bringing arms overhead. Jump back to start.",
      "imageName": "exercise_jumping_jacks",
      "targetMuscle": "Full Body",
      "difficulty": "Beginner",
      "category": "Warm-up",
      "tips": "Maintain a steady rhythm and land softly on the balls of your feet."
    },
    {
      "id": "arm_circles",
      "name": "Arm Circles",
      "description": "Stand with feet shoulder-width apart and extend arms to the sides. Make small circular motions with your arms.",
      "imageName": "exercise_arm_circles",
      "targetMuscle": "Shoulders",
      "difficulty": "Beginner",
      "category": "Warm-up",
      "tips": "Keep your arms straight and core engaged."
    },
    {
      "id": "high_knees",
      "name": "High Knees",
      "description": "Run in place while bringing your knees up towards your chest as high as possible.",
      "imageName": "exercise_high_knees",
      "targetMuscle": "Full Body, Cardio",
      "difficulty": "Beginner",
      "category": "Warm-up",
      "tips": "Pump your arms and stay on the balls of your feet."
    },
    {
      "id": "butt_kicks",
      "name": "Butt Kicks",
      "description": "Run in place, kicking your heels up to touch your glutes with every step.",
      "imageName": "exercise_butt_kicks",
      "targetMuscle": "Legs, Cardio",
      "difficulty": "Beginner",
      "category": "Warm-up",
      "tips": "Keep your torso upright and move your legs quickly."
    },
    {
      "id": "cat_cow",
      "name": "Cat-Cow Stretch",
      "description": "On all fours, alternate between arching your back (Cat) and dropping your belly while looking up (Cow).",
      "imageName": "exercise_cat_cow",
      "targetMuscle": "Back, Core",
      "difficulty": "Beginner",
      "category": "Warm-up",
      "tips": "Coordinate your movement with your breath."
    },
    {
      "id": "plank_to_dog",
      "name": "Plank to Downward Dog",
      "description": "From a plank position, push your hips back and up into a downward dog position.",
      "imageName": "exercise_plank_dog",
      "targetMuscle": "Shoulders, Hamstrings",
      "difficulty": "Beginner",
      "category": "Warm-up",
      "tips": "Keep your spine neutral and press your heels toward the floor."
    },
    {
      "id": "wall_push_up",
      "name": "Wall Push-Ups",
      "description": "Stand facing a wall, hands shoulder-width apart. Slowly bend your elbows and bring your chest toward the wall. Push back.",
      "imageName": "exercise_wall_pushup",
      "targetMuscle": "Chest, Triceps",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Keep your body straight from head to heels. Move slowly."
    },
    {
      "id": "kneeling_push_up",
      "name": "Kneeling Push-ups",
      "description": "Perform a push-up with your knees on the ground and feet lifted. Maintain a straight line from head to knees.",
      "imageName": "exercise_kneeling_pushup",
      "targetMuscle": "Chest, Triceps",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Keep your core tight and elbows at a 45-degree angle."
    },
    {
      "id": "push_up",
      "name": "Push-up",
      "description": "Start in a plank position with hands shoulder-width apart. Lower your chest to the floor while keeping your body straight, then push back up.",
      "imageName": "exercise_pushup",
      "targetMuscle": "Chest, Triceps, Shoulders",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Keep your core tight and spine neutral. Avoid letting your hips sag."
    },
    {
      "id": "decline_push_ups",
      "name": "Decline Push-ups",
      "description": "Perform a push-up with your feet on an elevated surface (like a chair) and hands on the floor.",
      "imageName": "exercise_decline_pushup",
      "targetMuscle": "Upper Chest, Shoulders",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Keep your neck neutral and hips in line with your body."
    },
    {
      "id": "wide_push_ups",
      "name": "Wide Push-ups",
      "description": "Perform a push-up with your hands placed wider than shoulder-width apart to target the outer chest.",
      "imageName": "exercise_wide_pushup",
      "targetMuscle": "Chest, Shoulders",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Don't let your elbows flare out too much."
    },
    {
      "id": "diamond_push_up",
      "name": "Diamond Push-ups",
      "description": "Start in a plank position with hands forming a diamond shape under your chest. Lower your chest slowly toward your hands, then push back up.",
      "imageName": "exercise_diamond_pushup",
      "targetMuscle": "Triceps, Chest",
      "difficulty": "Advanced",
      "category": "Exercise",
      "tips": "Engage your core and glutes to maintain a straight line. Keep elbows tight."
    },
    {
      "id": "archer_push_ups",
      "name": "Archer Push-ups",
      "description": "Assume a wide push-up position. Lower yourself to one side, keeping the opposite arm straight, then push back up and switch sides.",
      "imageName": "exercise_archer_pushup",
      "targetMuscle": "Chest, Shoulders, Triceps",
      "difficulty": "Advanced",
      "category": "Exercise",
      "tips": "Move slowly and control the descent. Keep your core very tight."
    },
    {
      "id": "superman",
      "name": "Superman",
      "description": "Lie face down on the floor. Simultaneously lift your arms, chest, and legs off the ground. Hold for a second and lower.",
      "imageName": "exercise_superman",
      "targetMuscle": "Lower Back, Glutes",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Look down at the floor to keep your neck neutral. Don't over-arch."
    },
    {
      "id": "bird_dog",
      "name": "Bird-Dog",
      "description": "Start on hands and knees. Extend one arm forward and the opposite leg backward. Hold, then switch sides.",
      "imageName": "exercise_bird_dog",
      "targetMuscle": "Back, Core, Balance",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Keep your hips level and avoid arching your back."
    },
    {
      "id": "scapular_pullups",
      "name": "Scapular Pull-ups",
      "description": "Hang from a bar and pull your shoulder blades down and together without bending your elbows.",
      "imageName": "exercise_scap_pullup",
      "targetMuscle": "Upper Back",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Control the movement and focus on the squeeze."
    },
    {
      "id": "reverse_snow_angels",
      "name": "Reverse Snow Angels",
      "description": "Lie face down. Lift your chest slightly. Move your arms in a wide arc from your hips to over your head, keeping them off the floor.",
      "imageName": "exercise_reverse_snow_angel",
      "targetMuscle": "Upper Back, Shoulders",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Squeeze your shoulder blades together throughout the movement."
    },
    {
      "id": "inverted_rows",
      "name": "Inverted Rows",
      "description": "Under a low bar or table, pull your chest toward the bar while keeping your body in a straight line.",
      "imageName": "exercise_inverted_row",
      "targetMuscle": "Back, Biceps",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "The more horizontal your body, the harder the exercise."
    },
    {
      "id": "pull_ups",
      "name": "Pull-ups",
      "description": "Grip a pull-up bar with palms facing away. Pull your body up until your chin is over the bar, then lower slowly.",
      "imageName": "exercise_pullup",
      "targetMuscle": "Back, Biceps",
      "difficulty": "Advanced",
      "category": "Exercise",
      "tips": "Avoid swinging. Use a full range of motion."
    },
    {
      "id": "shoulder_taps",
      "name": "Shoulder Taps",
      "description": "In a plank position, lift one hand and tap the opposite shoulder. Minimize hip movement.",
      "imageName": "exercise_shoulder_tap",
      "targetMuscle": "Shoulders, Core",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Widen your feet for more stability. Squeeze your glutes."
    },
    {
      "id": "pike_push_ups",
      "name": "Pike Push-ups",
      "description": "Assume a downward dog position. Lower the top of your head towards the floor by bending your elbows, then push back up.",
      "imageName": "exercise_pike_pushup",
      "targetMuscle": "Shoulders, Triceps",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Keep your hips high and look back towards your feet."
    },
    {
      "id": "handstand_push_ups",
      "name": "Handstand Push-ups",
      "description": "Perform a push-up while in a handstand position against a wall.",
      "imageName": "exercise_hspu",
      "targetMuscle": "Shoulders, Triceps",
      "difficulty": "Advanced",
      "category": "Exercise",
      "tips": "Keep your core tight and maintain a slight hollow body position."
    },
    {
      "id": "bodyweight_squat",
      "name": "Bodyweight Squat",
      "description": "Stand with feet shoulder-width apart. Lower your hips back and down as if sitting in a chair, then return to standing.",
      "imageName": "exercise_squat",
      "targetMuscle": "Legs, Glutes",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Keep your chest up and weight on your heels."
    },
    {
      "id": "lunges",
      "name": "Lunges",
      "description": "Step forward with one leg and lower your hips until both knees are bent at a 90-degree angle. Push back to start.",
      "imageName": "exercise_lunges",
      "targetMuscle": "Legs, Glutes",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Keep your front knee aligned with your ankle."
    },
    {
      "id": "calf_raises",
      "name": "Calf Raises",
      "description": "Stand with feet flat on the floor. Lift your heels as high as possible, hold, then lower.",
      "imageName": "exercise_calf_raises",
      "targetMuscle": "Calves",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Keep your core tight and don't rush the movement."
    },
    {
      "id": "glute_bridges",
      "name": "Glute Bridges",
      "description": "Lie on your back, knees bent. Lift your hips toward the ceiling, squeeze your glutes, then lower.",
      "imageName": "exercise_glute_bridge",
      "targetMuscle": "Glutes, Hamstrings",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Drive through your heels and don't over-arch your lower back."
    },
    {
      "id": "bulgarian_split_squat",
      "name": "Bulgarian Split Squats",
      "description": "Place one foot behind you on an elevated surface. Squat down with your front leg, then push back up.",
      "imageName": "exercise_bulgarian_squat",
      "targetMuscle": "Legs, Glutes",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Maintain an upright torso. Most of the weight should be on the front leg."
    },
    {
      "id": "side_lunges",
      "name": "Side Lunges",
      "description": "Stand with feet together. Step out to one side, lower your hips by bending that knee, keep the other leg straight, then push back.",
      "imageName": "exercise_side_lunge",
      "targetMuscle": "Legs, Inner Thighs",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Keep your weight on the heel of the bending leg."
    },
    {
      "id": "pistol_squats",
      "name": "Pistol Squats",
      "description": "Perform a squat on one leg while keeping the other leg extended forward.",
      "imageName": "exercise_pistol_squat",
      "targetMuscle": "Legs, Glutes, Balance",
      "difficulty": "Advanced",
      "category": "Exercise",
      "tips": "Use a chair for balance if needed initially. Keep your heel on the ground."
    },
    {
      "id": "jump_squats",
      "name": "Jump Squats",
      "description": "Perform a standard squat and jump explosively as you rise. Land softly and go into the next rep.",
      "imageName": "exercise_jump_squat",
      "targetMuscle": "Legs, Cardio",
      "difficulty": "Advanced",
      "category": "Exercise",
      "tips": "Focus on explosive power and a soft landing."
    },
    {
      "id": "burpees",
      "name": "Burpees",
      "description": "From standing, drop into a squat, kick feet back to plank, do a push-up, jump feet back to squat, and jump into the air.",
      "imageName": "exercise_burpees",
      "targetMuscle": "Full Body, Cardio",
      "difficulty": "Advanced",
      "category": "Exercise",
      "tips": "Maintain a steady pace and keep your core tight."
    },
    {
      "id": "crunches",
      "name": "Crunches",
      "description": "Lie on your back with knees bent. Lift your upper body slightly off the floor using your abdominal muscles.",
      "imageName": "exercise_crunches",
      "targetMuscle": "Abs",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Avoid pulling on your neck. Exhale as you crunch up."
    },
    {
      "id": "dead_bug",
      "name": "Dead Bug",
      "description": "Lie on your back, arms and knees up. Slowly lower the opposite arm and leg while keeping your back flat on the floor.",
      "imageName": "exercise_dead_bug",
      "targetMuscle": "Core, Stability",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Press your lower back into the ground throughout the movement."
    },
    {
      "id": "leg_raises",
      "name": "Leg Raises",
      "description": "Lie on your back with legs straight. Lift your legs toward the ceiling, then lower them slowly without touching the floor.",
      "imageName": "exercise_leg_raises",
      "targetMuscle": "Lower Abs",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Keep your lower back pressed against the floor."
    },
    {
      "id": "flutter_kicks",
      "name": "Flutter Kicks",
      "description": "Lie on your back with legs straight. Lift feet slightly and alternate small up-and-down kicks.",
      "imageName": "exercise_flutter_kicks",
      "targetMuscle": "Lower Abs",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Keep your core tight and legs straight."
    },
    {
      "id": "plank",
      "name": "Plank",
      "description": "Hold a push-up position but rest on your forearms. Keep your body in a straight line from head to heels.",
      "imageName": "exercise_plank",
      "targetMuscle": "Core",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Engage your core and glutes. Don't let your back arch."
    },
    {
      "id": "side_plank",
      "name": "Side Plank",
      "description": "Lie on your side, propped up by one forearm. Lift your hips to form a straight line from head to feet.",
      "imageName": "exercise_side_plank",
      "targetMuscle": "Obliques, Core",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Keep your hips high and stack your feet."
    },
    {
      "id": "mountain_climbers",
      "name": "Mountain Climbers",
      "description": "In a plank position, alternate bringing your knees towards your chest in a running motion.",
      "imageName": "exercise_mountain_climbers",
      "targetMuscle": "Core, Cardio",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Keep your hips low and maintain a flat back."
    },
    {
      "id": "plank_jacks",
      "name": "Plank Jacks",
      "description": "In a plank position, jump your feet out wide and then back together.",
      "imageName": "exercise_plank_jacks",
      "targetMuscle": "Core, Cardio",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Keep your core engaged and avoid letting your hips bounce too much."
    },
    {
      "id": "shadow_boxing",
      "name": "Shadow Boxing",
      "description": "Adopt a fighting stance and throw combinations of punches at an imaginary opponent.",
      "imageName": "exercise_boxing",
      "targetMuscle": "Full Body, Cardio",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Keep your hands up and move your feet constantly."
    },
    {
      "id": "bicycle_crunches",
      "name": "Bicycle Crunches",
      "description": "Lie on your back and simulate a pedaling motion with your legs while touching opposite elbow to opposite knee.",
      "imageName": "exercise_bicycle_crunch",
      "targetMuscle": "Abs, Obliques",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Focus on rotation and slow, controlled movements."
    },
    {
      "id": "russian_twist",
      "name": "Russian Twist",
      "description": "Sit on the floor, knees bent. Lean back slightly and rotate your torso from side to side.",
      "imageName": "exercise_russian_twist",
      "targetMuscle": "Abs, Obliques",
      "difficulty": "Intermediate",
      "category": "Exercise",
      "tips": "Keep your back straight and feet off the floor for more challenge."
    },
    {
      "id": "v_ups",
      "name": "V-Ups",
      "description": "Lie on your back. Simultaneously lift your legs and torso to form a 'V' shape, reaching for your toes.",
      "imageName": "exercise_v_up",
      "targetMuscle": "Abs",
      "difficulty": "Advanced",
      "category": "Exercise",
      "tips": "Keep your arms and legs straight. Control the descent."
    },
    {
      "id": "hollow_body_hold",
      "name": "Hollow Body Hold",
      "description": "Lie on your back. Lift your head, shoulders, and legs slightly off the floor. Press your lower back into the ground.",
      "imageName": "exercise_hollow_hold",
      "targetMuscle": "Core",
      "difficulty": "Advanced",
      "category": "Exercise",
      "tips": "The lower your legs, the harder the exercise. Focus on the lower back contact."
    },
    {
      "id": "bench_dips",
      "name": "Bench Dips",
      "description": "Use a chair or bench behind you. Lower your hips by bending your elbows, then push back up.",
      "imageName": "exercise_bench_dips",
      "targetMuscle": "Triceps",
      "difficulty": "Beginner",
      "category": "Exercise",
      "tips": "Keep your back close to the bench. Don't go too deep if it hurts your shoulders."
    },
    {
      "id": "chest_stretch",
      "name": "Chest Stretch",
      "description": "Stand tall, interlace your fingers behind your back, and gently lift your arms while keeping your chest open.",
      "imageName": "exercise_chest_stretch",
      "targetMuscle": "Chest",
      "difficulty": "Beginner",
      "category": "Cool-down",
      "tips": "Breathe deeply and hold the stretch without bouncing."
    },
    {
      "id": "cobra_stretch",
      "name": "Cobra Stretch",
      "description": "Lie face down, hands under shoulders. Push up to lift your chest off the floor while keeping hips down.",
      "imageName": "exercise_cobra_stretch",
      "targetMuscle": "Abs, Back",
      "difficulty": "Beginner",
      "category": "Cool-down",
      "tips": "Keep your shoulders down and away from your ears."
    },
    {
      "id": "childs_pose",
      "name": "Child's Pose",
      "description": "Kneel on the floor, sit on your heels, and lean forward to rest your forehead on the ground with arms extended.",
      "imageName": "exercise_childs_pose",
      "targetMuscle": "Back, Shoulders",
      "difficulty": "Beginner",
      "category": "Cool-down",
      "tips": "Relax your whole body and breathe deeply."
    },
    {
      "id": "hamstring_stretch",
      "name": "Hamstring Stretch",
      "description": "Sit on the floor with one leg extended and reach for your toes. Keep your back straight.",
      "imageName": "exercise_hamstring_stretch",
      "targetMuscle": "Legs",
      "difficulty": "Beginner",
      "category": "Cool-down",
      "tips": "Don't force the reach. Breathe into the stretch."
    },
    {
      "id": "quad_stretch",
      "name": "Quad Stretch",
      "description": "Stand on one leg, grab the opposite ankle and pull it towards your glutes. Switch sides.",
      "imageName": "exercise_quad_stretch",
      "targetMuscle": "Legs, Quads",
      "difficulty": "Beginner",
      "category": "Cool-down",
      "tips": "Keep your knees together and stand upright."
    }
  ],
